{
  "name": "HomeSection",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Section Title"
    },
    "section_type": {
      "type": "string",
      "title": "Section Type",
      "enum": [
        "products",
        "cta_cards",
        "editorial",
        "ad_banner",
        "articles"
      ],
      "default": "products"
    },
    "category": {
      "type": "string",
      "title": "Category Filter (leave empty for top products)"
    },
    "sort_order": {
      "type": "integer",
      "title": "Sort Order",
      "default": 0
    },
    "limit": {
      "type": "integer",
      "title": "Product Limit",
      "default": 8
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}